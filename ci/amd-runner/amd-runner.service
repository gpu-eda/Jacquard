# systemd unit for the AMD iGPU ephemeral GitHub Actions runner (Docker, ROCm + Vulkan).
# Sibling of blackwell-runner.service; differs only in device passthrough (raw AMD
# iGPU nodes instead of --gpus all) and labels.
#
# Install on nvidia1.local:
#   sudo cp amd-runner.service /etc/systemd/system/
#   sudo install -d -m 700 /etc/amd-runner
#   # create /etc/amd-runner/env (root:root 600):
#   #   RUNNER_PAT=github_pat_xxx
#   #   GH_OWNER=gpu-eda
#   #   GH_REPO=            # empty = org-level runner
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now amd-runner
#
# NOTE: this runs the *runner* image (amd-runner:latest = amd-bench + actions-runner
# + entrypoint.sh). Build that thin layer first; amd-bench:latest alone has no runner.
[Unit]
Description=AMD iGPU ephemeral GitHub Actions runner (Docker, ROCm+Vulkan)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# No start limit. The container exits after every job (--ephemeral) and systemd
# restarts it, so each job counts as a start: an enforced limit would stop the
# runner for good after a burst of short jobs, or after a few minutes of failed
# starts (a missing image, an expired PAT), until someone ran reset-failed.
# StartLimit* keys belong in [Unit]; in [Service] systemd ignores the interval.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/amd-runner/env
ExecStartPre=-/usr/bin/docker rm -f amd-runner
# Raphael iGPU = PCI 0f:00.0. Its DRM node numbers are NOT stable across boots: before
# 2026-10-20 it was renderD128/card1, after that reboot the NVIDIA card took those and
# the iGPU became renderD129/card2, so ROCm in the container saw no AMD device. The
# nodes are therefore resolved from the stable by-path symlinks at start, and passed
# through under their real names. Mapping them to a fixed in-container name does not
# work: ROCm opens /dev/dri/renderD<minor> using the minor it reads from the host's
# KFD topology in sysfs. The by-path names contain ':', which `--device` cannot take
# directly, hence the shell. ($$ escapes `$` from systemd's own expansion.)
# --group-add uses NUMERIC host GIDs so the non-root runner can reach the device nodes:
#   993 = render (owns /dev/kfd, renderD*), 44 = video (owns card*). Verify with
#   `getent group render video` if the host is ever rebuilt.
ExecStart=/bin/sh -c 'set -e; \
    render=$$(readlink -e /dev/dri/by-path/pci-0000:0f:00.0-render); \
    card=$$(readlink -e /dev/dri/by-path/pci-0000:0f:00.0-card); \
    exec /usr/bin/docker run --rm --name amd-runner \
    --device /dev/kfd \
    --device "$$render" \
    --device "$$card" \
    --group-add 993 --group-add 44 \
    --security-opt seccomp=unconfined \
    --pull never \
    -e RUNNER_PAT -e GH_OWNER -e GH_REPO \
    -e RUNNER_LABELS=self-hosted,amd,gfx1036,rocm,hip,vulkan,cubecl \
    amd-runner:latest'
ExecStop=/usr/bin/docker stop amd-runner
Restart=always
# A failing start retries every RestartSec: ~360 registration-token calls an
# hour at worst, well inside the GitHub API rate limit.
RestartSec=10

[Install]
WantedBy=multi-user.target
